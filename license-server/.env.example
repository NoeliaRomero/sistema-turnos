# ── Servidor de Licencias ─────────────────────────────────────────────────────
# Copiar este archivo a .env y completar los valores reales

# Puerto del servidor
PORT=4000

# Ruta a la base de datos SQLite
DB_PATH=./data/licenses.db

# Clave PRIVADA RSA (RS256) — generada con: node license-server/scripts/genKeys.js
# Pegar la clave completa (incluyendo \n como saltos de línea escapados)
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgk....\n-----END PRIVATE KEY-----"

# Secreto para JWT del panel de administración (string aleatorio largo)
ADMIN_JWT_SECRET=tu_secreto_muy_largo_aqui_min_32_chars

# Contraseña del admin del panel de licencias (solo se usa en el primer run)
LICENSE_ADMIN_PASS=CambiarEstoEnProduccion123!
