{
  "name": "sistema-turnos-biper",
  "version": "1.1.0",
  "description": "Sistema de gestión de turnos y llamado por biper",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "electron:start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64"
  },
  "build": {
    "appId": "ar.com.sistemauniversal.plus",
    "productName": "Sistema Universal Plus",
    "files": [
      "**/*",
      "!db/turnos.db",
      "!db/*.db-shm",
      "!db/*.db-wal",
      "!tools/**",
      "!dist*/**",
      "!.claude/**",
      "!capacitor.config.json",
      "!db/session.key",
      "!db/install.id",
      "!db/license.lic",
      "!db/server.port",
      "!backups/**",
      "!license-server/**",
      "!tools/private.pem",
      "!tools/*.lic",
      "!.git/**",
      "!*.md",
      "!.env*"
    ],
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/@serialport/**",
      "node_modules/serialport/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "archiver": "^5.3.2",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "node-cron": "^4.6.0",
    "serialport": "^13.0.0",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "bootstrap": "^5.3.2",
    "bootstrap-icons": "^1.11.3",
    "chart.js": "^4.4.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.0.3"
  }
}
